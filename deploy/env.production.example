# EMBMIS Gateway — production environment. Copy to .env.production (never commit it).
# Generate secrets on the server:  openssl rand -hex 24

# --- Where the generated keys live on the host (npm run keys:prod -- /srv/gateway/keys) ---
SAG_GATEWAY_SECRETS=/srv/gateway/keys/gateway-secrets
SAG_WORKER_SECRETS=/srv/gateway/keys/worker-secrets
SAG_POLICY_DIR=/srv/gateway/keys/policy

# --- Required ---
REDIS_PASSWORD=
# SHA-256 of each platform key (npm run platform-key prints it). Comma-separate several to rotate.
SAG_PLATFORM_KEY_HASHES=
# Console accounts that may change gateway-wide settings (comma-separated emails).
SAG_ADMIN_EMAILS=
GATEWAY_PUBLIC_URL=https://gateway.example.com
# The path the gateway is served under. A dedicated host (the default): SAG_BASE_PATH empty, CONSOLE_BASE=/.
# Under a path of a shared host, e.g. https://example.com/gateway: SAG_BASE_PATH=/gateway and CONSOLE_BASE=/gateway/
# (change them as a pair; the console is built for CONSOLE_BASE).
SAG_BASE_PATH=
CONSOLE_BASE=/
# true: anyone can create a workspace (a hosted gateway). false: only the operators above (a gateway you run for yourself).
SAG_ALLOW_REGISTRATION=true

# --- Optional ---
SAG_MODE=enforce
# Intent analysis with a language model
LLM_API_KEY=
LLM_MODEL=
# Escalation notifications
SLACK_WEBHOOK_URL=
SMTP_URL=
# Only with: docker compose --profile enterprise-db ... (the demo database execute-path workers protect)
POSTGRES_USER=sag
POSTGRES_PASSWORD=
POSTGRES_DB=enterprise_db

# --- Storage -----------------------------------------------------------------------------------------------
# Leave empty to keep the gateway's data in SQLite on the gateway_data volume (one gateway instance).
# To store it in PostgreSQL (own `gateway` schema and `sag_gateway` role; see DEPLOY.md for creating them):
#   SAG_DATABASE_URL=postgres://sag_gateway:<hex password>@<host>:5432/<database>
# Use a hex password (openssl rand -hex 24) so it needs no URL-encoding.
SAG_DATABASE_URL=
