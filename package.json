    "test:keys": "node tests/key-guard.test.js",
    "platform-key": "node scripts/platform-key.js",
    "console:install": "npm --prefix console install",
    "console:build": "npm --prefix console run build",
    "console:dev": "npm --prefix console run dev",
    "keys:prod": "node scripts/keys-prod.js",
    "sign-bundle": "node scripts/sign-bundle.js",
    "lint": "node scripts/lint.js",
    "build": "npm run console:build"
  },
  "keywords": [],
