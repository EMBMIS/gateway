  "license": "Apache-2.0",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "node-forge": "^1.3.3",
    "pg": "^8.19.0",
    "redis": "^5.11.0",
    "uuid": "^13.0.0",
    "ws": "^8.19.0"
