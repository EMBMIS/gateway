# ─── Required ────────────────────────────────────────────────────────────────
APP_URL=https://your-domain.com

# ─── Database (leave DB_ADAPTER=sqlite for local dev) ────────────────────────
DB_ADAPTER=sqlite
# DB_ADAPTER=postgres
# DATABASE_URL=postgresql://sag:sagpassword@sag-postgres:5432/sag
# POSTGRES_USER=sag
# POSTGRES_PASSWORD=changeme_in_production
# POSTGRES_DB=sag

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_in_production

# ─── Gateway ─────────────────────────────────────────────────────────────────
SAG_MODE=enforce
NODE_ENV=production

# ─── LLM (optional — enables semantic intent analysis) ───────────────────────
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# ─── Notifications (optional) ────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/...
# SMTP_URL=smtp://user:pass@smtp.example.com:587

# ─── Keys (never commit real values; see SECURITY-ROTATION.md) ───────────────
# Local development: `npm run keys:dev` generates everything into certs/ (gitignored).
# Production: mount a read-only secrets directory and point at it ...
# SAG_SECRETS_DIR=/run/secrets/sag
#   expected files: gateway-ed25519.key/.pub, worker-ed25519.key/.pub, ca-cert.pem,
#   server-cert.pem, server-key.pem, client-cert.pem, client-key.pem,
#   alias_policy-authority-v0.4_public.pem
# ... or inject PEM (or base64 of the PEM) through environment variables:
# SAG_GATEWAY_ED25519_KEY=   SAG_GATEWAY_ED25519_PUB=
# SAG_WORKER_ED25519_KEY=    SAG_WORKER_ED25519_PUB=
# SAG_TLS_CA_CERT=  SAG_TLS_SERVER_CERT=  SAG_TLS_SERVER_KEY=  SAG_TLS_CLIENT_CERT=  SAG_TLS_CLIENT_KEY=
# SAG_POLICY_PUBLIC_KEY=
# With NODE_ENV=production the gateway and workers refuse to start if any key is missing or is one of
# the keys that were once committed to this repository (checked by fingerprint).
